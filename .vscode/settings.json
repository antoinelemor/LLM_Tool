{
    // No "python.defaultInterpreterPath" here on purpose: it holds a single
    // value, and the interpreter lives in .venv/bin/python on macOS and Linux
    // but .venv\Scripts\python.exe on Windows. The Python extension already
    // auto-detects a .venv in the workspace root on every platform, and
    // install.sh / install.ps1 write the exact path for the machine they run on.
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    // The CLI prints emoji, box-drawing characters and multilingual text. On
    // Windows the integrated terminal would otherwise hand Python the ANSI code
    // page and the first banner would raise UnicodeEncodeError.
    "terminal.integrated.env.windows": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
    },
    "files.eol": "\n",
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "ms-python.black-formatter"
    }
}
