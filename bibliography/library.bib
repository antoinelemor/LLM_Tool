@article{leslieIntegratingSocialSciences2020,
  title = {Integrating the Social Sciences into the {{COVID-19}} Response in {{Alberta}}, {{Canada}}},
  author = {Leslie, Myles and Fadaak, Raad and Davies, Jan and Blaak, Johanna and Forest, P. G. and Green, Lee and Conly, John},
