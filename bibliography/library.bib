  shorttitle = {Public {{Health}} and {{Health Sector Crisis Leadership During Pandemics}}},
  author = {Sriharan, Abi and Hertelendy, Attila J. and {Banaszak-Holl}, Jane and {Fleig-Palmer}, Michelle M. and Mitchell, Cheryl and Nigam, Amit and Gutberg, Jennifer and Rapp, Devin J. and Singer, Sara J.},
