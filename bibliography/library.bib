@misc{madaniMeasuringDimensionsSelfPresentation2024,
  title = {Measuring {{Dimensions}} of {{Self-Presentation}} in {{Twitter Bios}} and Their {{Links}} to {{Misinformation Sharing}}},
  author = {Madani, Navid and Bandyopadhyay, Rabiraj and {Swire-Thompson}, Briony and Yoder, Michael Miller and Joseph, Kenneth},
  year = {2024},
  month = sep,
  number = {arXiv:2305.09548},
  eprint = {2305.09548},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2305.09548},
  urldate = {2025-02-03},
  abstract = {Social media platforms provide users with a profile description field, commonly known as a ``bio," where they can present themselves to the world. A growing literature shows that text in these bios can improve our understanding of online self-presentation and behavior, but existing work relies exclusively on keyword-based approaches to do so. We here propose and evaluate a suite of {\textbackslash}hl\{simple, effective, and theoretically motivated\} approaches to embed bios in spaces that capture salient dimensions of social meaning, such as age and partisanship. We {\textbackslash}hl\{evaluate our methods on four tasks, showing that the strongest one out-performs several practical baselines.\} We then show the utility of our method in helping understand associations between self-presentation and the sharing of URLs from low-quality news sites on Twitter{\textbackslash}hl\{, with a particular focus on explore the interactions between age and partisanship, and exploring the effects of self-presentations of religiosity\}. Our work provides new tools to help computational social scientists make use of information in bios, and provides new insights into how misinformation sharing may be perceived on Twitter.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computation and Language},
  file = {/Users/antoine/Zotero/storage/XCZR6MEL/Madani et al. - 2024 - Measuring Dimensions of Self-Presentation in Twitter Bios and their Links to Misinformation Sharing.pdf;/Users/antoine/Zotero/storage/KDJMCHWH/2305.html}
}

