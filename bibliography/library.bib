  booktitle = {Towards {{Industry}} 4.0 --- {{Current Challenges}} in {{Information Systems}}},
  author = {Rot, Artur and Sobi{\'n}ska, Ma{\l}gorzata and Hernes, Marcin and Franczyk, Bogdan},
  editor = {Hernes, Marcin and Rot, Artur and Jelonek, Dorota},
