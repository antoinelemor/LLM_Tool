@article{adeelCOVID19PolicyResponse2020,
  title = {{{COVID-19 Policy Response}} and the {{Rise}} of the {{Sub-National Governments}}},
  author = {Adeel, Abdul Basit and Catalano, Michael and Catalano, Olivia and Gibson, Grant and Muftuoglu, Ezgi and Riggs, Tara and Sezgin, Mehmet Halit and Shvetsova, Olga and Tahir, Naveed and {VanDusky-Allen}, Julie and Zhao, Tianyi and Zhirnov, Andrei},
  year = {2020},
  month = nov,
  journal = {Canadian Public Policy},
  volume = {46},
  number = {4},
  pages = {565--584},
  publisher = {University of Toronto Press},
  issn = {0317-0861},
  doi = {10.3138/cpp.2020-101},
  urldate = {2021-01-23},
  abstract = {We examine the roles of sub-national and national governments in Canada and the United States vis-{\`a}-vis the protective public health response in the onset phase of the global coronavirus disease 2019 (COVID-19) pandemic. This period was characterized in both countries by incomplete information as well as by uncertainty regarding which level of government should be responsible for which policies. The crisis represents an opportunity to study how national and sub-national governments respond to such policy challenges. In this article, we present a unique dataset that catalogues the policy responses of US states and Canadian provinces as well as those of the respective federal governments: the Protective Policy Index (PPI). We then compare the United States and Canada along several dimensions, including the absolute values of sub-national levels of the index relative to the total protections enjoyed by citizens, the relationship between early threat (as measured by the mortality rate near the start of the public health crisis) and the evolution of the PPI, and finally the institutional and legislative origins of the protective health policies. We find that the sub-national contribution to policy is more important for both the United States and Canada than are their national-level policies, and it is unrelated in scope to our early threat measure. We also show that the institutional origin of the policies as evidenced by the COVID-19 response differs greatly between the two countries and has implications for the evolution of federalism in each.},
  file = {/Users/antoine/Zotero/storage/XRZMVBJP/Adeel et al. - 2020 - COVID-19 Policy Response and the Rise of the Sub-N.pdf}
}

@misc{adelmanTwoModelsScientific2006,
  title = {Two {{Models}} for {{Scientific Transparency}} in {{Environmental Law}}},
  author = {Adelman, David E.},
  year = {2006},
  month = jul,
  journal = {Rescuing Science from Politics: Regulation and the Distortion of Scientific Research},
  pages = {193--214},
  publisher = {Cambridge University Press},
  doi = {10.1017/CBO9780511751776.013},
  urldate = {2020-04-01},
  abstract = {{$<$}div class="abstract" data-abstract-type="normal"{$><$}p{$>$}Transparency in Science and in Law{$<$}/p{$><$}p{$>$}Maximizing the transparency of scientific determinations is critically important to the disciplines that inform environmental policy. Environmental issues are riven by disputes over the use of quantitative methods and by uncertainty about risk. Despite the obvious limits of science, or perhaps because of them, agency officials and political actors who use science often fail to represent scientific uncertainty accurately, and instead overstate the role that science played in supporting particular findings to elevate the outcomes to which they are predisposed. As a result, science without transparency risks devolving into consequentialist science.{$<$}/p{$><$}p{$>$}Chemical risk assessment provided the impetus for much of the debate over how science is used in a regulatory context. Objections to chemical risk assessment methods stem from the high uncertainties in risk estimates that exist at the low exposure levels relevant to regulatory standards. The controversy is also driven by the potential consequences of inaction -- failures to protect workers against asbestos exposures, for example, may result in 250,000 additional cancers in the United States. These uncertainties require scientists to make difficult judgments, including critically important decisions to rely on highly simplified models to obtain the quantitative results needed to derive regulatory standards.{$<$}/p{$><$}p{$>$}The vulnerability of scientific judgment to political pressure is evident in the high-profile controversies surrounding the Bush Administration's stacking of scientific advisory committees in agencies throughout the federal government.{$<$}/p{$><$}/div{$>$}},
  howpublished = {/core/books/rescuing-science-from-politics/two-models-for-scientific-transparency-in-environmental-law/6913F6A79EFE3823D1EFE74D831AD9F4},
  langid = {english},
  file = {/Users/antoine/Zotero/storage/5F5LCQSE/Adelman - 2006 - Two Models for Scientific Transparency in Environmental Law.pdf}
}

