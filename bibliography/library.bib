@article{howlettNetworksMatterLinking2002,
  title = {Do {{Networks Matter}}? {{Linking Policy Network Structure}} to {{Policy Outcomes}}: {{Evidence}} from {{Four Canadian Policy Sectors}} 1990-2000},
  shorttitle = {Do {{Networks Matter}}?},
  author = {Howlett, Michael},
  year = {2002},
