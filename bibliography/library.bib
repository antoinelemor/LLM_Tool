  pages = {667--689},
  issn = {1754-7121},
  doi = {10.1111/capa.12500},
  urldate = {2025-07-21},
  abstract = {Sommaire Le ph{\'e}nom{\`e}ne de la bureaucratie de guichet a peu {\'e}t{\'e} {\'e}tudi{\'e} du point de vue des cons{\'e}quences de l'activit{\'e} des professionnels sur l'organisation. Comment l'existence de la bureaucratie de guichet peut-elle contribuer {\`a} influer sur la structure d'un minist{\`e}re? Peut-on {\'e}tablir un parall{\`e}le entre bureaucratie de guichet et hybridit{\'e}? Cette {\'e}tude s'int{\'e}resse {\`a} ces ph{\'e}nom{\`e}nes au minist{\`e}re des Affaires municipales et de l'Habitation du Qu{\'e}bec. Les auteures constatent qu'un ensemble de facteurs contribue {\`a} assurer un certain poids {\`a} cette bureaucratie de guichet, principalement compos{\'e}e de personnel professionnel, ce qui induit des ph{\'e}nom{\`e}nes d'hybridit{\'e} structurelle et institutionnelle.},
  langid = {french},
  file = {/Users/antoine/Zotero/storage/6KDKGSLJ/Goupil and Gagnon - 2022 - Bureaucratie de guichet et hybridité au ministère des Affaires municipales et de l'Habitation.pdf}
}

