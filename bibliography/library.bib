@article{maurerNewSelfGovernanceTheoretical2017,
  title = {The {{New Self-Governance}}: {{A Theoretical Framework}}},
  shorttitle = {The {{New Self-Governance}}},
  author = {Maurer, Stephen M.},
  year = {2017},
  month = mar,
  journal = {Business and Politics},
  volume = {19},
  number = {1},
  pages = {41--67},
  issn = {14693569},
  urldate = {2019-04-25},
  abstract = {Industry has organized increasingly effective self-governance initiatives since the 1980s. Almost all of these are based on the economic leverage of large retailers and manufacturers over their worldwide supply chains. This article documents commonalities in six of the best-studied examples--coffee, dolphin-safe tuna, fisheries, lumber, food processing, and artificial DNA--and offers straightforward economic and political theories to explain them. The theories teach that oligopoly competition can strongly constrain private power so that firms are answerable to a shadow electorate of consumers. Furthermore, rational firms often benefit from ceding significant power to suppliers and NGOs. These results extend traditional arguments that free markets constrain private power and suggest an explicit framework for deciding when private politics are legitimate.},
  keywords = {Business Administration: General          M10,Business Objectives of the Firm          L21,Contracts and Reputation,International Business          F23,Multinational Firms,Networks          L14,Oligopoly and Other Imperfect Markets          L13,Political Processes: Rent-seeking Lobbying Elections Legislatures and Voting Behavior          D72,Transactional Relationships},
  file = {/Users/antoine/Zotero/storage/HJ3BJ7UN/Maurer - 2017 - The New Self-Governance A Theoretical Framework.pdf}
}

