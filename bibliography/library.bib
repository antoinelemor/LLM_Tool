@article{genestTranslatingCOVID19Emergency2021,
  title = {Translating {{COVID-19}} Emergency Plans into Policy: {{A}} Comparative Analysis of Three {{Canadian}} Provinces},
  shorttitle = {Translating {{COVID-19}} Emergency Plans into Policy},
  author = {Genest, Gabriel Blouin and Burlone, Nathalie and Champagne, Eric and Eastin, Carl and Ogaranko, Claire},
  year = {2021},
  month = jan,
  journal = {Policy Design and Practice},
  volume = {4},
  number = {1},
  pages = {115--132},
  publisher = {Routledge},
  issn = {null},
  doi = {10.1080/25741292.2020.1868123},
  urldate = {2021-05-31},
  abstract = {Following recent health crises---mad cow, SARS, H1N1---, countries and subnational entities refined their policy infrastructure to better respond to outbreaks, leading to pandemic emergency plans. These plans, which are the result of complex public policy-making processes, were translated into public policies during the COVID-19 pandemic, leading to important policy issues and changes. Were these plans applied as planned? How did they evolve, as a policy object, during the pandemic? How do they compare among national/subnational entities? This paper proposes a comparative analysis of the existing plans, their temporal mobilization during the first 3 weeks of the pandemic, the policies they led to, and their successive revisions within a short period of time. Our analysis problematizes the translation process between policy and practice, bringing new light to the policy-making process under emergency and crisis. Informed by policy learning research and using a qualitative content analysis of existing COVID-19 pandemic plans in the three largest and most affected Canadian provinces (Qu{\'e}bec, Ontario, and British Columbia), this article provides not only a better understanding of real-time policy making but also crisis-induced policy learning at the organizational level.},
  keywords = {canada,Correction,COVID-19,emergency plan,pandemic preparedness,public policy},
  file = {/Users/antoine/Zotero/storage/DDEG93QU/Genest et al. - 2021 - Translating COVID-19 emergency plans into policy .pdf;/Users/antoine/Zotero/storage/7BNVGZ35/25741292.2020.html}
}

