  author = {Smith, Katherine},
  editor = {Smith, Katherine},
  year = {2013},
  series = {Palgrave {{Studies}} in {{Science}}, {{Knowledge}} and {{Policy}}},
  pages = {201--212},
  publisher = {Palgrave Macmillan UK},
  address = {London},
  doi = {10.1057/9781137026583_7},
  urldate = {2021-11-16},
  abstract = {This short penultimate chapter highlights how various factors relating to the organisation of policymaking institutions, including the short time frames within which policymakers are commonly required to work, combined with an often rapid level of staff turnover, contribute to an extremely limited institutional memory. This can lead to similar ideas being recycled as they are re-presented (or as they re-emerge) as new ideas. It also suggests that researchers, for a variety of reasons (including the pressure to obtain research funding), do not always seek to draw policymakers' attention to the recycling of similar ideas. Perhaps more positively (for those keen to ensure public health research does inform policy), the chapter notes that this means research-informed ideas are likely to have multiple opportunities to influence policy.},
  isbn = {978-1-137-02658-3},
  langid = {english},
  keywords = {British Heart Foundation,Knowledge Broker,Knowledge Translation,Public Health Research,Social Research Council}
}

