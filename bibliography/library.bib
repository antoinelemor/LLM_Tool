  abstract = {Content analysis is a valuable tool for analysing policy discourse, but annotation by humans is costly and time-consuming. ChatGPT is a potentially valuable tool to automate content analysis for policy debates, largely replacing human annotators. We evaluate ChatGPT's ability to classify documents using argument descriptions, by comparing its performance with human annotators for two policy debates: the Universal Basic Income debate on Dutch Twitter (2014-2016) and the pension reforms debate in German newspapers (1993-2001). We use the most current API (GPT-4 Turbo) and user interface version (GPT-4) and evaluate multiple performance metrics (accuracy, precision and recall). ChatGPT is highly reliability and accurate in classifying pre-defined arguments across datasets. However, precision and recall are much lower, and vary strongly between arguments. These results hold for both datasets, despite differences in language and media type. Moreover, the cutoff method proposed in this paper may aid researchers in navigating the trade-off between detection and noise. Overall, we do not (yet) recommend a blind application of ChatGPT to classify arguments in policy debates. Those interested in adopting this tool should manually validate bot classifications before using them in further analyses. At least for now, human annotators are here to stay.},
  archiveprefix = {OSF},
  langid = {american},
  file = {/Users/antoine/Zotero/storage/H44B4UJV/Gielens and Sowula - 2024 - Goodbye Human Annotators Content Analysis of Policy Debates using ChatGPT.pdf}
}

@article{gigerenzerHomoHeuristicusWhy2009,
  title = {Homo {{Heuristicus}}: {{Why Biased Minds Make Better Inferences}}},
  shorttitle = {Homo {{Heuristicus}}},
  author = {Gigerenzer, Gerd and Brighton, Henry},
  year = {2009},
  journal = {Topics in Cognitive Science},
  volume = {1},
  number = {1},
  pages = {107--143},
  issn = {1756-8765},
  doi = {10.1111/j.1756-8765.2008.01006.x},
  urldate = {2021-01-12},
  abstract = {Heuristics are efficient cognitive processes that ignore information. In contrast to the widely held view that less processing reduces accuracy, the study of heuristics shows that less information, computation, and time can in fact improve accuracy. We review the major progress made so far: (a) the discovery of less-is-more effects; (b) the study of the ecological rationality of heuristics, which examines in which environments a given strategy succeeds or fails, and why; (c) an advancement from vague labels to computational models of heuristics; (d) the development of a systematic theory of heuristics that identifies their building blocks and the evolved capacities they exploit, and views the cognitive system as relying on an ``adaptive toolbox;'' and (e) the development of an empirical methodology that accounts for individual differences, conducts competitive tests, and has provided evidence for people's adaptive use of heuristics. Homo heuristicus has a biased mind and ignores part of the available information, yet a biased mind can handle uncertainty more efficiently and robustly than an unbiased mind relying on more resource-intensive and general-purpose processing strategies.},
  copyright = {Copyright {\copyright} 2009 Cognitive Science Society, Inc.},
  langid = {english},
  keywords = {Decision-making,Heuristics,Induction,Inferences,Rationality,Uncertainity},
  file = {/Users/antoine/Zotero/storage/LQEU822X/Gigerenzer et Brighton - 2009 - Homo Heuristicus Why Biased Minds Make Better Inf.pdf;/Users/antoine/Zotero/storage/UTJTRJZF/j.1756-8765.2008.01006.html}
}

