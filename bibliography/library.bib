  langid = {english},
  pmid = {33158911},
  file = {/Users/antoine/Zotero/storage/NTJ63T8Z/Pei et al. - 2020 - Differential effects of intervention timing on COV.pdf;/Users/antoine/Zotero/storage/943CKG2M/eabd6370.html}
