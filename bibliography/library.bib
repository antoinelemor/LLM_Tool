@article{hesstvedtPoliticalAdministrativeControl2023,
  title = {Political and Administrative Control of Expert Groups---{{A}} Mixed-Methods Study},
  author = {Hesstvedt, Stine and Christensen, Johan},
  year = {2023},
  journal = {Governance},
  volume = {36},
  number = {2},
  pages = {337--357},
  issn = {1468-0491},
  doi = {10.1111/gove.12599},
  urldate = {2023-08-18},
  abstract = {Governments face a fundamental dilemma when asking expert groups for advice. Experts possess knowledge that can help governments design effective and legitimate policies. However, they can also propose different policies than those preferred by government. How do governments solve this conundrum? Through a mixed-methods study, the article examines politico-administrative control with expert advisory commissions in Norway. Arguing that both politicians and bureaucrats can take interest in limiting the gap between political/administrative policy preferences and expert group output, the article examines by what means they seek to control expert groups and how control varies across policy portfolios. It finds that while politicians rely on control by design, bureaucrats use both design and interventions. Moreover, political and bureaucratic controls are stronger in the area of financial/economic policy than elsewhere. The article makes a novel contribution to scholarship at the intersection of public administration and knowledge and policymaking.},
  copyright = {{\copyright} 2021 The Authors. Governance published by Wiley Periodicals LLC.},
  langid = {english},
  file = {/Users/antoine/Zotero/storage/Z74HBAX4/Hesstvedt et Christensen - 2023 - Political and administrative control of expert gro.pdf;/Users/antoine/Zotero/storage/52A25AD9/gove.html}
}

