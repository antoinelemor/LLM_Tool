@article{cairneyCOVID19EffectivePolicymaking2020,
  title = {{{COVID-19}}: Effective Policymaking Depends on Trust in Experts, Politicians, and the Public},
  shorttitle = {{{COVID-19}}},
  author = {Cairney, Paul and Wellstead, Adam},
  year = {2020},
  month = oct,
  journal = {Policy Design and Practice},
  volume = {0},
  number = {0},
  pages = {1--14},
  publisher = {Routledge},
  issn = {null},
  doi = {10.1080/25741292.2020.1837466},
  urldate = {2021-01-23},
  abstract = {In a crisis, almost-instant choices about who to trust or distrust could make a difference between life and death. Trust is necessary for cooperation, coordination, social order, and to reduce the need for coercive state imposition. During a pandemic, people need to trust experts to help them understand and respond to the problem, governments to coordinate policy instruments and make choices about levels of coercion, and citizens as they cooperate to minimize infection. We compare these general requirements with specific developments in the UK and US, identifying: the variable reliance by elected politicians on scientific experts, worrying levels of distrust in elected leaders, and a shift from a trust-based to more impositional forms of government action (with more variation in responses in the US). While trust is difficult to define and measure, these examples show that people miss it when it is gone.},
  keywords = {COVID-19 policy,distrust,science advice,trust,UK,US},
  file = {/Users/antoine/Zotero/storage/U3SLYXGC/Cairney et Wellstead - 2020 - COVID-19 effective policymaking depends on trust .pdf;/Users/antoine/Zotero/storage/4JIDQYAA/25741292.2020.html}
}

