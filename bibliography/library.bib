  urldate = {2021-11-16},
  abstract = {In reviewing the recommendations emerging out of analyses of the relationship between research and policy, Chapter 1 notes that developing closer relationships between researchers and policymakers is one of the most popular recommendations (see Box 1.1). The rationale underlying this recommendation is that closer relationships will help engender trust between researchers and policymakers as well as enabling researchers to gain a better understanding of the policymaking process and the institutional constraints within which policymakers operate. Reflecting this, the interview data suggest that many academics and policymakers involved in public health in the UK support the idea that closer relationships between researchers and policymakers would increase the use of research in policy. However, many interviewees also had strong reservations about this approach, partly reflecting Innv{\ae}r and colleagues' (2002) concerns that, while closer relationships might increase the flow of research into policy, they do not necessarily optimise the use of research (see also Acharya 2011). Moreover, while policy-based interviewees repeatedly suggested that academics who were deemed to be too critical were likely to be excluded from policy discussions, many also suggested that one of the key attributes policymakers looked for in academics was their credibility among their academic peers. For example: Senior civil servant (England): `The government tends to like experts who are recognised as experts by their peers [...] but who won't too obviously rock the boat. Constant critics tend to lose favour because ministers (like everybody else) don't like to be criticised.'},
  isbn = {978-1-137-02658-3},
  langid = {english},
  keywords = {Civil Servant,Health Inequality,Medical Model,Public Health Research,Tobacco Control}
}

@incollection{smithPoliticsAdvocacyPublic2013,
  title = {Politics and {{Advocacy}} in {{Public Health}} --- {{A Way Forward}}},
  booktitle = {Beyond {{Evidence-Based Policy}} in {{Public Health}}: {{The Interplay}} of {{Ideas}}},
  author = {Smith, Katherine},
  editor = {Smith, Katherine},
  year = {2013},
  series = {Palgrave {{Studies}} in {{Science}}, {{Knowledge}} and {{Policy}}},
  pages = {213--219},
  publisher = {Palgrave Macmillan UK},
  address = {London},
  doi = {10.1057/9781137026583_8},
  urldate = {2021-11-16},
  abstract = {This book began (in Chapters 1 and 2) by considering some of the ongoing debates about the relationship between research and policy, particularly (in Chapter 2) in the context of public health. It highlighted an apparently unresolved tension between rational, instrumental conceptualisations of the relationship (which are often employed within public health) and those based on politics, democracy, ideologies and values (which are widely employed within political science). Building on the growing academic interest in the role of ideas in policymaking (e.g. B{\'e}land 2005; Blyth 1997; Stevens 2007), the book argued that focusing on `ideas' rather than `evidence' might provide one means of overcoming this tension, for the notion of `research-informed ideas' allows space to acknowledge normative, political and empirical dimensions of public health debates. In addition, the concept of `research-informed ideas' better acknowledges the malleable nature of knowledge which is translated as it moves between actors and across contexts. Overall, the book argues that it is both empirically accurate and conceptually useful to think of the relationship between public health research and policy as an `interplay of ideas' (Rein 1980). This draws attention to the fact policy informs research, as well as the other way around, and to the fact that both research and policy tend to be shaped by broad, overarching ideas that may, in some contexts, be taken for granted (discourses, frames, paradigms or, in the terms of this book, `institutionalised ideas').},
  isbn = {978-1-137-02658-3},
  langid = {english},
  keywords = {Health Inequality,Knowledge Broker,Policy Change,Public Health Research,Tobacco Control}
}

@incollection{smithPowerIdeasEvidence2013,
  title = {The {{Power}} of {{Ideas}} ({{Over Evidence}})},
  booktitle = {Beyond {{Evidence-Based Policy}} in {{Public Health}}: {{The Interplay}} of {{Ideas}}},
  author = {Smith, Katherine},
  editor = {Smith, Katherine},
  year = {2013},
  series = {Palgrave {{Studies}} in {{Science}}, {{Knowledge}} and {{Policy}}},
  pages = {70--110},
  publisher = {Palgrave Macmillan UK},
  address = {London},
  doi = {10.1057/9781137026583_3},
  urldate = {2021-11-16},
  abstract = {While it may seem self-evident that ideas matter, political science has, for a long time, been so preoccupied with the role that institutions and interests play in policy change that work on analysing the contribution of ideas has remained at the margins (B{\'e}land and Cox 2011). Although ideas were clearly `an important variable' in many of the analyses developed by political scientists in the 1970s and 1980s, this literature said `very little about the specific role that ideas play in the policy process or about the characteristics that tend to give some ideas more influence than others over policy' (Hall 1990: p. 57). Indeed, it is only over the past 15 years that ideational theories have attracted a significant intellectual spotlight within political science and policy studies (e.g. B{\'e}land 2005; B{\'e}land and Cox 2011; Blyth 1997; Campbell 1998, 2002; Goldstein and Keohane 1993; Howorth 2004), even though Weiss was arguing for attention to be paid to ideas back in the early 1980s: It is not usually a single finding or the recommendation derived from a single study that is adopted in executive of legislative action (although this occasionally happens). [...] Instead, what seems to happen is that generalizations and ideas from a number of studies come into currency indirectly --- through articles in academic journals of opinion, stories in the media, the advice of consultants, lobbying by special interest groups, conversations with colleagues, attendance at conferences or training programmes, and other uncatalogued sources. Ideas from research are picked up in diverse ways and percolate through to officeholders in many offices who deal with the issues. (Weiss 1982: p. 622)},
  isbn = {978-1-137-02658-3},
  langid = {english},
  keywords = {Causal Belief,Health Inequality,Reduce Health Inequality,Tobacco Control,Tobacco Industry}
}

