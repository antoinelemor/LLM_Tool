@article{alvaresPopulismExtremismMedia2016,
  title = {Populism, Extremism and Media: {{Mapping}} an Uncertain Terrain},
  shorttitle = {Populism, Extremism and Media},
  author = {Alvares, Claudia and Dahlgren, Peter},
  year = {2016},
  month = feb,
  journal = {European Journal of Communication},
  volume = {31},
  number = {1},
  pages = {46--57},
  publisher = {SAGE Publications Ltd},
  issn = {0267-3231},
  doi = {10.1177/0267323115614485},
  urldate = {2020-11-11},
  abstract = {Aiming to critically review key research on populism, extremism and media, this article examines some definition aspects of populism as a concept, its relation to `the people' and points to future directions for research in mainstream -- and social media -- the terrain where so much of the political is played out. An individualisation of civic cultures has emerged in tandem with the growth of mediated populism through the use of new technologies, with a tendency towards personalisation in the public domain. While the new technological affordances exemplified by Web 2.0 may have contributed to intensified forms of popular engagement, they have been less successful in promoting democratic values, as shown by the results of the May 2014 European Parliamentary elections. Thus, the question as to the type of publics that are `possible and desirable in present circumstances' (Nolan, 2008: 747) remains valid, for publics can espouse anti-democratic values while nevertheless remaining `publics'. The fact that the link between the new media and right-wing extremism has been comparatively explored at greater length than that of a religious bend indicates the need to invest in the latter, especially due to home-bred Islamic terrorism increasingly seen as threatening the multiculturalism of various European societies. Several avenues for research are presented to this effect, with a final reflection on the challenge posed by new media to the concept of media populism, both in terms of the Net's market logics and the specificity of its architecture.},
  langid = {english},
  file = {/Users/antoine/Zotero/storage/AGZN8TFF/Alvares et Dahlgren - 2016 - Populism, extremism and media Mapping an uncertai.pdf}
}

@inbook{alvessonAthomeEthnographyStruggling2009,
  title = {At-Home Ethnography: {{Struggling}} with Closeness and Closure},
  booktitle = {Organizational {{Ethnography}}: {{Studying}} the {{Complexity}} of {{Everyday Life}}},
  author = {Alvesson, M.},
  year = {2009},
  month = aug,
  publisher = {SAGE},
  abstract = {Just as newspapers do not, typically, engage with the ordinary experiences of people{$\prime$}s daily lives, so organizational studies has also tended largely to ignore the humdrum, everyday experiences of people working in organizations. However, ethnographic approaches provide in-depth and up-close understandings of how the {$\prime$}everyday-ness{$\prime$} of work is organized and how, in turn, work itself organizes people and the societies they inhabit.   Organizational Ethnography brings contributions from leading scholars in organizational studies that serve to unpack an ethnographic perspective on organizations and organizational research. The authors explore the particular problems faced by organizational ethnographers, including:   - questions of gaining access to research sites within organizations; - the many styles of writing organizational ethnography; - the role of friendship relations in the field; - problems of distance and closeness;  - the doing of at-home ethnography; - ethical issues;  - standards for evaluating ethnographic work.   This book is a vital resource for organizational scholars and students doing or writing ethnography in the fields of business and management, public administration, education, health care, social work, or any related field in which organizations play a role.},
  collaborator = {Ybema, Sierk and Yanow, Dvora and Wels, Harry and Kamsteeg, Frans H.},
