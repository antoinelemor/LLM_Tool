@article{balmeChineRegleDroit2014,
  title = {{Chine : la r{\`e}gle de droit aux marges d'un empire bureaucratique et absolutiste (1978-2014)}},
  shorttitle = {{Chine}},
  author = {Balme, St{\'e}phanie},
  year = {2014},
  month = nov,
  journal = {Revue francaise d'administration publique},
  volume = {N{$^\circ$} 150},
  number = {2},
  pages = {393--413},
  issn = {0152-7401},
  urldate = {2019-06-21},
  abstract = {{$<$}titre{$>$}R\&\#233;sum\&\#233;{$<$}/titre{$>$} En Chine, la dynamique des plans successifs de r\&\#233;formes juridiques lanc\&\#233;s depuis la fin des ann\&\#233;es 1970 cache difficilement une r\&\#233;alit\&\#233; quotidienne faite d\&\#8217;attaques frontales contre le constitutionalisme et l\&\#8217;\&\#201;tat de droit. Sur le terrain, on ne peut que constater les \&\#233;carts qui existent entre les d\&\#233;clarations d\&\#8217;intention, le contenu du droit positif et les pratiques. Dans ce contexte, quel bilan peut-on dresser de plusieurs d\&\#233;cennies de r\&\#233;formes juridiques engag\&\#233;es par le Parti communiste chinois (PCC) au nom de l\&\#8217;\&\#201;tat de droit\&\#160;\&\#187; ( yifa zhiguo )? \&\#192; partir de la constitution d\&\#8217;une base de donn\&\#233;es comprenant l\&\#8217;ensemble des lois et r\&\#232;glements administratifs promulgu\&\#233;s au niveau national entre 1978 et mars 2014, cet article pr\&\#233;sente une synth\&\#232;se des principales \&\#233;tapes de la r\&\#233;volution juridique de l\&\#8217;\&\#232;re post Mao ainsi que l\&\#8217;\&\#233;volution des principaux acteurs institutionnels de la fabrique du droit. Tout en reconnaissant les progr\&\#232;s consid\&\#233;rables effectu\&\#233;s durant la p\&\#233;riode \&\#233;tudi\&\#233;e, ce travail montre le labyrinthe normatif d\&\#233;sordonn\&\#233; que constitue toujours le droit chinois. Cette situation nous semble la cause plus que la cons\&\#233;quence de l\&\#8217;emp\&\#234;chement de la branche l\&\#233;gislative du pouvoir \&\#224; se constituer en pouvoir autonome. Au cours des ann\&\#233;es 2000, la mont\&\#233;e d\&\#8217;un appareil s\&\#233;curitaire s\&\#8217;est adoss\&\#233;e au syst\&\#232;me r\&\#232;glementaire, arbitraire, existant. Nous concluons que la dissonance observ\&\#233;e entre un droit positif relativement \&\#233;clair\&\#233; et les pratiques d\&\#8217;un \&\#201;tat policier ne rel\&\#232;ve pas d\&\#8217;une contradiction dialectique mais de l\&\#8217;incapacit\&\#233; - ou du refus - du PCC \&\#224; cr\&\#233;er les m\&\#233;canismes juridiques techniques d\&\#8217;\&\#233;laboration d\&\#8217;un \&\#201;tat de droit. Par cons\&\#233;quent, une telle situation interdit, pour l\&\#8217;heure, d\&\#8217;en fonder les principes \&\#233;thiques, philosophiques et politiques.},
  langid = {french},
  file = {/Users/antoine/Zotero/storage/SXGJP5AD/Balme - 2014 - Chine  la règle de droit aux marges d'un empire b.pdf;/Users/antoine/Zotero/storage/HW9QMJB9/revue-francaise-d-administration-publique-2014-2-page-393.html}
}

