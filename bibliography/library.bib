@phdthesis{rapsonAssessingInfluenceIndividualism2021,
  type = {M.{{P}}.{{H}}.},
  title = {Assessing the {{Influence}} of {{Individualism}} vs. {{Collectivism}} at the {{National Level}} on {{Government Response Measures}} to {{Covid-19}}},
  author = {Rapson, Colin},
  year = {2021},
  journal = {ProQuest Dissertations and Theses},
  address = {Ann Arbor},
  abstract = {Governments all over the world have taken actions to mitigate the spread of COVID-19, implementing varying levels of policy response measures. Previous studies have thoroughly investigated factors associated with these response measures, however, there are few cross-cultural comparisons among countries, specifically looking at national levels of individualism and collectivism. The purpose of this study was to examine and assess the influence a country's individualistic or collectivistic values has on the stringency of its government's response measures.  The study analyzed 43 countries, all of which met certain criteria based on OECD membership, democracy levels, and high-income status. To quantify each country's individualistic or collectivistic value and government response measures, the Hofstede Individualism Index and the OxCGRT Government Stringency Index were used respectively. The stringency level was calculated for each country when it recorded its 100th, 500th, 1000th, 5000th, and 10000th COVID-19 case. The Government Stringency Index was regressed on the Individualism Index for all 43 countries at each respective COVID-19 case count threshold. The study found that, on average, governments of collectivistic countries (n=20) implemented stricter response measures more rapidly than governments of individualistic countries (n=23). However, as COVID-19 cases increased within a country, the difference in government response measures between collectivistic and individualistic countries became less significant. The results suggest that collectivism is a contributing factor towards government implementation of stricter and more rapid response measures. That said, it is not likely the decisive factor, as issues such as effective leadership, competency, and determination come into play.},
  isbn = {9798569940875},
  langid = {english},
  school = {Yale University},
  keywords = {0573:Public health,0630:Public policy,0766:Epidemiology,Collectivism,COVID-19,Epidemiology,Government health policy,Government response measures,Individualism,Microbial Diseases,Public health,Public policy},
  annotation = {28262632},
  note = {Copyright - Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.
\par
Derni{\`e}re mise {\`a} jour - 2021-03-11}
}

