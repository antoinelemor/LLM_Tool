@article{howlettComparingPolicyAdvisory2019a,
  title = {Comparing Policy Advisory Systems beyond the {{OECD}}: Models, Dynamics and the Second-Generation Research Agenda},
  shorttitle = {Comparing Policy Advisory Systems beyond the {{OECD}}},
  author = {Howlett, Michael},
  year = {2019},
  month = jul,
