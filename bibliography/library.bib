@article{armingeonMutingScienceInput2022,
  title = {Muting {{Science}}: {{Input Overload Versus Scientific Advice}} in {{Swiss Policy Making During}} the {{Covid-19 Pandemic}}},
  shorttitle = {Muting {{Science}}},
  author = {Armingeon, Klaus and Sager, Fritz},
  year = {2022},
  journal = {The Political Quarterly},
  volume = {93},
  number = {3},
  pages = {424--432},
  issn = {1467-923X},
  doi = {10.1111/1467-923X.13151},
  urldate = {2023-01-17},
  abstract = {This article explores why the Swiss Federal Council and the Swiss Federal Parliament were reluctant to follow the majority views of the scientific epidemiological community at the beginning of the second wave of the Covid-19 pandemic. We propose an institutionalist take on this question and argue that one major explanation could be the input overload that is characteristic of the Swiss federal political system. We define input overload as the simultaneous inputs of corporatist, pluralist, federalist and direct democratic subsystems. Adding another major input---this time from the scientific subsystem---may have threatened to further erode the government's and parliament's discretionary power to cope with the pandemic. We assume that the federal government reduced its input overload by fending off scientific advice.},
  langid = {english},
  keywords = {Covid-19,institutionalism,science-policy interface,scientific policy advice,Switzerland},
  file = {/Users/antoine/Zotero/storage/VN5U2PT5/Armingeon et Sager - 2022 - Muting Science Input Overload Versus Scientific A.pdf;/Users/antoine/Zotero/storage/JUSFETWZ/1467-923X.html}
}

