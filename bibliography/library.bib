@article{djidjou-demasseEpidemiologieMathematiqueModelisation2020,
  title = {{{\'E}pid{\'e}miologie math{\'e}matique et mod{\'e}lisation de la pand{\'e}mie de Covid-19 : enjeux et diversit{\'e}}},
  shorttitle = {{{\'E}pid{\'e}miologie math{\'e}matique et mod{\'e}lisation de la pand{\'e}mie de Covid-19}},
