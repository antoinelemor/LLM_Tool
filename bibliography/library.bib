@article{chevrierVeilleLINSPQCoconstruction2019,
  title = {{La veille {\`a} l'INSPQ~: une~co-construction fructueuse}},
  shorttitle = {{La veille {\`a} l'INSPQ}},
  author = {Chevrier, Julien and Lacourse, Mah{\'e}e},
