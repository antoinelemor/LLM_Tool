@article{craftCatchingSecondWave2017a,
  title = {Catching a {{Second Wave}}: {{Context}} and {{Compatibility}} in {{Advisory System Dynamics}}},
  shorttitle = {Catching a {{Second Wave}}},
  author = {Craft, Jonathan and Wilder, Matt},
  year = {2017},
  journal = {Policy Studies Journal},
  volume = {45},
  number = {1},
  pages = {215--239},
  issn = {1541-0072},
  doi = {10.1111/psj.12133},
  urldate = {2023-03-10},
  abstract = {``Policy advisory systems'' have been central to moving beyond individual actor considerations to assessments of the interactive effects of multiple interlocking sets of suppliers, in specific jurisdictions, that provide policy advice to policymakers. This article argues, while useful, the advisory system concept should be revised given that previous approaches animated by the location of supply and government control over it have been weakened. We argue for a ``second wave'' of advisory system studies that: (1) reorients the unit of analysis from the public service to advisory systems themselves, (2) better contextualizes advisory system operation and dynamics based on the subsystems within which they operate, and (3) focuses on questions of why advisory system components combine in particular policy instances and with what effect. Using access and compatibility, we posit a typology of policy advisory networks and develop four archetypes of policy ideational compatibility.},
  langid = {english},
  keywords = {context,policy advice,policy theory,public management,subsystems},
  file = {/Users/antoine/Zotero/storage/YJA5GCFF/Craft et Wilder - 2017 - Catching a Second Wave Context and Compatibility .pdf;/Users/antoine/Zotero/storage/52ADAMI4/psj.html}
}

