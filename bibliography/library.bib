  title = {Experiments with {{LDA}} and {{Top2Vec}} for Embedded Topic Discovery on Social Media Data---{{A}} Case Study of Cystic Fibrosis},
  author = {Karas, Bradley and Qu, Sue and Xu, Yanji and Zhu, Qian},
  year = {2022},
