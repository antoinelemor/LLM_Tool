@article{aligicaInstitutionalResilienceEconomic2014,
  title = {Institutional {{Resilience}} and {{Economic Systems}}: {{Lessons}} from {{Elinor Ostrom}}'s {{Work}}},
  shorttitle = {Institutional {{Resilience}} and {{Economic Systems}}},
  author = {Aligica, Paul Dragos and Tarko, Vlad},
  year = {2014},
  month = mar,
  journal = {Comparative Economic Studies},
  volume = {56},
  number = {1},
  pages = {52--76},
  issn = {1478-3320},
  doi = {10.1057/ces.2013.29},
  urldate = {2025-02-20},
  abstract = {Comparative economic systems literature deals extensively with `systemic functions' and `performance criteria' such as growth, efficiency and equity but rarely mentions the topic of resilience. This paper focusses on the issue of resilience while drawing several important lessons from the contributions in this respect of 2009 Nobel Prize in Economics co-recipient, Elinor Ostrom: The effects of alternative institutional arrangements and social norms as a source of both resilience and vulnerability; the problem of `highly optimized tolerance' to specific sources of uncertainty; polycentricity as a possible structural solution to sustainability problems. A key point is that resilience is more than mere `absorptive capacity' or `speed of recovery': it depends on innovation and creative socio-cultural adaptations made possible by flexible and polycentric institutional processes. That has important implications for the ways we define and assess institutional performance and institutional design.},
  langid = {english},
  keywords = {B52,comparative economic systems,D02,institutional design,institutional theory,institutions,O17,O43,P48,polycentricity,socio-ecological systems,vulnerability},
