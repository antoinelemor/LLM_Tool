@misc{biliottiBreakingLockdownCausal2023,
  title = {Breaking {{Down}} the {{Lockdown}}: {{The Causal Effects}} of {{Stay-At-Home Mandates}} on {{Uncertainty}} and {{Sentiments During}} the {{COVID-19 Pandemic}}},
  shorttitle = {Breaking {{Down}} the {{Lockdown}}},
  author = {Biliotti, C. and {Bargagli-Stoffi}, F. J. and Fraccaroli, N. and Puliga, M. and Riccaboni, M.},
  year = {2023},
  month = jun,
  number = {arXiv:2212.01705},
  eprint = {2212.01705},
  primaryclass = {cs, econ, q-fin, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2212.01705},
  urldate = {2023-11-28},
  abstract = {We study the causal effects of lockdown measures on uncertainty and sentiment on Twitter. To this end, we exploit the quasi-experimental framework created by the first COVID-19 lockdown in a high-income economy--the unexpected Italian lockdown in February 2020. We measure changes in public sentiment using deep learning and dictionary-based methods on the text of daily tweets geolocated within and near the locked-down areas, before and after the treatment. We classify tweets into four categories--economics, health, politics, and lockdown policy--to examine how the policy affected emotions heterogeneously. Using a staggered difference-in-differences approach, we show that the lockdown did not have a significantly robust impact on economic uncertainty and sentiment. However, the policy came at the price of higher uncertainty on health and politics and more negative political sentiments. These results, which are robust to a battery of robustness tests, show that lockdowns have relevant non-health related implications.},
