@article{goyalMeasuringMixPolicy2021,
  title = {``{{Measuring}} the {{Mix}}'' of {{Policy Responses}} to {{COVID-19}}: {{Comparative Policy Analysis Using Topic Modelling}}},
  shorttitle = {``{{Measuring}} the {{Mix}}'' of {{Policy Responses}} to {{COVID-19}}},
  author = {Goyal, Nihit and Howlett, Michael},
  year = {2021},
  month = mar,
  journal = {Journal of Comparative Policy Analysis: Research and Practice},
  volume = {23},
  number = {2},
  pages = {250--261},
  issn = {1387-6988, 1572-5448},
  doi = {10.1080/13876988.2021.1880872},
  urldate = {2021-04-26},
  abstract = {Although understanding initial responses to a crisis such as COVID-19 is important, existing research on the topic has not been systematically comparative. This study uses topic modeling to inductively analyze over 13,000 COVID-19 policies worldwide. This technique enables the COVID-19 policy mixes to be characterized and their cross-country variation to be compared. Significant variation was found in the intensity, density, and balance of policy mixes adopted across countries, over time, and by level of government. This study advances research on policy responses to the pandemic, specifically, and the operationalization of policy mixes, more generally.},
  langid = {english},
  file = {/Users/antoine/Zotero/storage/V6I2QAVD/Goyal et Howlett - 2021 - “Measuring the Mix” of Policy Responses to COVID-1.pdf}
}

