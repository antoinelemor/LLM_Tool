  publisher = {Presses de Sciences Po},
  issn = {1291-1941},
  urldate = {2020-03-31},
  abstract = {{$<$}titre{$>$}R\&\#233;sum\&\#233;{$<$}/titre{$>$} En r\&\#233;habilitant le concept d\&\#8217;id\&\#233;ologie, Paul Ric\&\#339;ur s\&\#8217;emploie \&\#224; r\&\#233;soudre son paradoxe sous-jacent, mis en \&\#233;vidence par K.\&\#160;Mannheim. Tout se passe en effet comme si toute critique de l\&\#8217;id\&\#233;ologie \&\#233;tait soup\&\#231;onn\&\#233;e elle-m\&\#234;me d\&\#8217;appartenir \&\#224; une id\&\#233;ologie. Pour sortir de ce cercle vicieux, P.\&\#160;Ric\&\#339;ur ne suit ni la voie engag\&\#233;e par la \&\#171;\&\#160;science\&\#160;\&\#187; marxiste ni la voie inspir\&\#233;e par la sociologie de la connaissance dont il montre respectivement le caract\&\#232;re apor\&\#233;tique. La contribution originale de l\&\#8217;herm\&\#233;neute consiste \&\#224; r\&\#233;soudre le paradoxe de l\&\#8217;id\&\#233;ologie en puisant dans les ressources d\&\#8217;une philosophie politique. \&\#192; l\&\#8217;opposition inop\&\#233;rante science/id\&\#233;ologie, Ric\&\#339;ur pr\&\#233;f\&\#232;re mettre en \&\#339;uvre une dialectique subtile entre utopie et id\&\#233;ologie. En d\&\#8217;autres termes, une critique de l\&\#8217;id\&\#233;ologie n\&\#8217;est concevable que sur la base d\&\#8217;un discours utopique qui met \&\#224; distance l\&\#8217;ordre social en proposant un horizon \&\#233;mancipateur.},
  langid = {french}
}

