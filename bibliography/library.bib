@article{arielyLadministrationPubliqueSatisfaction2013,
  title = {{L'administration publique et la satisfaction des citoyens par rapport {\`a} la d{\'e}mocratie : Observations transnationales}},
  shorttitle = {{L'administration publique et la satisfaction des citoyens par rapport {\`a} la d{\'e}mocratie}},
  author = {Ariely, Gal},
  year = {2013},
  journal = {Revue Internationale des Sciences Administratives},
  volume = {Vol. 79},
  number = {4},
  pages = {801--821},
  publisher = {I.I.S.A.},
  issn = {0303-965X},
  urldate = {2021-11-08},
  abstract = {Dans le pr\&\#233;sent article, nous examinons le lien entre d\&\#233;mocratie et bureaucratie en nous int\&\#233;ressant au r\&\#244;le jou\&\#233; par l\&\#8217;administration publique dans le maintien de la satisfaction des citoyens par rapport \&\#224; la d\&\#233;mocratie. Notre analyse multiniveaux, qui s\&\#8217;appuie sur des donn\&\#233;es transnationales issues de 35 pays, nous permet d\&\#8217;examiner tant l\&\#8217;\&\#233;chelon individuel que l\&\#8217;\&\#233;chelon national. En ce qui concerne ce premier niveau, les observations indiquent que ce que pensent les citoyens de l\&\#8217;administration publique est davantage li\&\#233; \&\#224; leur satisfaction par rapport \&\#224; la d\&\#233;mocratie qu\&\#8217;\&\#224; d\&\#8217;autres explications \&\#8211; comme la confiance politique, l\&\#8217;\&\#233;quit\&\#233; \&\#233;lectorale et l\&\#8217;efficacit\&\#233; politique. En ce qui concerne le second \&\#233;chelon, on constate que la qualit\&\#233; de l\&\#8217;administration publique est tout autant li\&\#233;e \&\#224; la satisfaction par rapport \&\#224; la d\&\#233;mocratie qu\&\#8217;\&\#224; d\&\#8217;autres macro-facteurs \&\#8211; comme le niveau de d\&\#233;mocratie, la confiance politique et le d\&\#233;veloppement humain dans un pays. Nous examinerons les r\&\#233;sultats dans le cadre du d\&\#233;bat sur le lien entre d\&\#233;mocratie et bureaucratie.Remarques \&\#224; l\&\#8217;intention des praticiensDans le pr\&\#233;sent article, nous mettons en \&\#233;vidence le r\&\#244;le essentiel jou\&\#233; par l\&\#8217;administration publique dans le maintien de l\&\#8217;adh\&\#233;sion des citoyens \&\#224; la d\&\#233;mocratie. Notre analyse indique que l\&\#8217;image de la fonction publique est fortement li\&\#233;e \&\#224; la satisfaction par rapport \&\#224; la d\&\#233;mocratie et que la qualit\&\#233; de l\&\#8217;administration publique est positivement li\&\#233;e \&\#224; la satisfaction par rapport \&\#224; la d\&\#233;mocratie, dans une mesure comparable aux autres explications. Pour les professionnels de la gestion publique et de l\&\#8217;administration, cela suppose que malgr\&\#233; les critiques actuelles des politiciens et autres experts \&\#224; l\&\#8217;\&\#233;gard de la fonction publique, son importance pour la satisfaction d\&\#233;mocratique des citoyens ne doit pas \&\#234;tre minimis\&\#233;e.},
  langid = {french},
