@article{brooksDevelopmentEUHealth2020,
  title = {The Development of {{EU}} Health Policy and the {{Covid-19}} Pandemic: Trends and Implications},
  shorttitle = {The Development of {{EU}} Health Policy and the {{Covid-19}} Pandemic},
  author = {Brooks, Eleanor and Geyer, Robert},
  year = {2020},
  month = nov,
  journal = {Journal of European Integration},
  volume = {42},
  number = {8},
  pages = {1057--1076},
  publisher = {Routledge},
  issn = {0703-6337},
  doi = {10.1080/07036337.2020.1853718},
  urldate = {2021-11-14},
  abstract = {EU health policy is a policy forged in crisis. Whilst maintaining the strict limitations on the EU's role that are described in the treaties, crises have historically been followed by incremental but integrative policy change. Given this trend, should we be expecting a radical expansion of EU health policy in the aftermath of Covid-19? And, if so, what parameters and characteristics might this new agenda have? As we enter the period in which the EU will try to elaborate its new health policy, this paper uses a Complexity perspective to assess how the emerging agenda compares to existing and historical EU action on health, the kind of decision-making that we are likely to see in the different areas of action, and the limitations of EU health policy development as it pushes into more political and complex areas of policy.},
  keywords = {complexity,Covid-19,EU health policy,policy agenda},
  file = {/Users/antoine/Zotero/storage/Y8LRBUQX/Brooks et Geyer - 2020 - The development of EU health policy and the Covid-.pdf;/Users/antoine/Zotero/storage/XFLUXTUN/07036337.2020.html}
}

